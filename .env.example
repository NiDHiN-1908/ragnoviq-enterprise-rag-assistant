# ===========================
# RAGNoviq Environment Variables
# ===========================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
ENVIRONMENT=development

# LLM Configuration (Choose one)
# Using Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# Using Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro

# Selected LLM Provider (groq or gemini)
LLM_PROVIDER=groq

# Embeddings Configuration
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, chromadb
VECTOR_DB_PATH=./data/vector_db
CHUNK_SIZE=512
CHUNK_OVERLAP=102

# Web Scraping Configuration
MAX_CRAWL_DEPTH=5
MAX_PAGES_PER_DOMAIN=100
REQUEST_TIMEOUT=30
USER_AGENT=RAGNoviq/1.0 (+https://ragnoviq.ai)
ENABLE_JAVASCRIPT=False

# Database Configuration
DATABASE_URL=sqlite:///./data/ragnoviq.db
DATABASE_ECHO=False

# API Security
API_KEY_HEADER=X-API-Key
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/ragnoviq.log

# Redis Configuration (Optional, for caching)
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=True
CACHE_TTL=3600

# Retrieval Configuration
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.5
USE_METADATA_FILTER=True

# Processing Configuration
ENABLE_ASYNC_PROCESSING=True
MAX_WORKERS=4
BATCH_SIZE=32

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Monitoring & Analytics
ENABLE_TELEMETRY=False
SENTRY_DSN=
